    "@types/pg": "^8.11.10",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "~9.39.5",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "testcontainers": "^12.2.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
