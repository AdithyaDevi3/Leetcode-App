# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=leetcode_app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Supabase Auth (email/password). These are public browser values. Copy them
# from the Supabase project. Never put database passwords, service-role keys, or
# other server credentials in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-only production Postgres connection. This overrides POSTGRES_* when
# set. Use the Supabase pooler connection string with sslmode=require.
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@your-host:6543/postgres?sslmode=require

# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Vercel automatically supplies VERCEL_URL and VERCEL_PROJECT_PRODUCTION_URL as
# server-side fallbacks. Keep NEXT_PUBLIC_APP_URL set to the canonical public URL
# in production so authentication emails always return to the intended domain.

# Evaluation queue. Keep the default in-memory store only for local development.
# Production requires the PostgreSQL migration set and a protected worker scheduler.
EVALUATION_JOB_STORE=memory
EVALUATION_WORKER_TOKEN=replace-with-a-long-random-secret
EVALUATION_REVIEWER_TOKEN=replace-with-a-separate-long-random-secret
EVALUATION_QUEUE_MAX_AGE_MS=60000
EVALUATION_JOB_STALE_AFTER_MS=300000
EVALUATION_SUBMISSIONS_PER_MINUTE=12
# AI remains disabled by default. Do not enable until an approved provider,
# budget cap, redaction review, and operational rollback path are in place.
EVALUATION_AI_ENABLED=false

# Safe coding workspace. Vercel deployments use Vercel Sandbox with automatic
# OIDC authentication. Judge0 remains available for self-hosted deployments.
# Provider credentials and tokens must never be exposed to the browser.
CODE_EXECUTION_ENABLED=false
CODE_EXECUTION_PROVIDER=vercel-sandbox
EXECUTION_WORKER_TOKEN=replace-with-a-separate-long-random-secret
EXECUTION_SUBMISSIONS_PER_TEN_MINUTES=10
EXECUTION_JOB_STALE_AFTER_MS=300000
EXECUTION_QUEUE_MAX_AGE_MS=60000
JUDGE0_ENDPOINT=https://your-isolated-judge0.example.com
JUDGE0_TOKEN=replace-with-a-server-only-secret
JUDGE0_TYPESCRIPT_LANGUAGE_ID=74
JUDGE0_PYTHON_LANGUAGE_ID=71
