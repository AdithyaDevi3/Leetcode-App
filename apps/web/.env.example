# Authentication
# Generate a secure secret with: openssl rand -base64 32
AUTH_SECRET=your-nextauth-secret-here

# OAuth Providers
# Google OAuth - Get from https://console.cloud.google.com/
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret

# GitHub OAuth - Get from https://github.com/settings/developers
AUTH_GITHUB_ID=your-github-client-id
AUTH_GITHUB_SECRET=your-github-client-secret

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=leetcode_app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Supabase (optional during the staged migration)
# These are public browser values. Copy the URL and publishable key from the
# Supabase project's Connect dialog. Never put database passwords, service-role
# keys, or other server credentials in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-only hosted Postgres connection. When set, the existing repository
# layer uses this connection string instead of the POSTGRES_* values above.
# Use the Supabase pooler connection string with sslmode=require in production.
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@your-host:6543/postgres?sslmode=require

# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Evaluation queue. Keep the default in-memory store only for local development.
# Production requires the PostgreSQL migration set and a protected worker scheduler.
EVALUATION_JOB_STORE=memory
EVALUATION_WORKER_TOKEN=replace-with-a-long-random-secret
EVALUATION_REVIEWER_TOKEN=replace-with-a-separate-long-random-secret
EVALUATION_QUEUE_MAX_AGE_MS=60000
EVALUATION_JOB_STALE_AFTER_MS=300000
EVALUATION_SUBMISSIONS_PER_MINUTE=12

# Safe coding workspace. Leave disabled until a sandbox provider and isolated
# worker deployment are configured. Never expose the Judge0 token to the browser.
CODE_EXECUTION_ENABLED=false
EXECUTION_WORKER_TOKEN=replace-with-a-separate-long-random-secret
EXECUTION_SUBMISSIONS_PER_TEN_MINUTES=10
EXECUTION_JOB_STALE_AFTER_MS=300000
EXECUTION_QUEUE_MAX_AGE_MS=60000
JUDGE0_ENDPOINT=https://your-isolated-judge0.example.com
JUDGE0_TOKEN=replace-with-a-server-only-secret
JUDGE0_TYPESCRIPT_LANGUAGE_ID=74
JUDGE0_PYTHON_LANGUAGE_ID=71
