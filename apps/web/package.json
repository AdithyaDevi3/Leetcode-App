    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@leetcode-app/database": "workspace:*",
    "@leetcode-app/domain": "workspace:*",
    "@leetcode-app/observability": "workspace:*",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@vercel/sandbox": "3.9.0",
